#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

CONFIG_ONLY=false
REQUESTED_PROFILE="${DOTFILES_PROFILE:-}"
ENVY_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --omarchy-config)
      CONFIG_ONLY=true
      ;;
    --profile)
      shift
      if [[ $# -eq 0 ]]; then
        echo "ERROR: --profile requires work or personal" >&2
        exit 1
      fi
      REQUESTED_PROFILE="$1"
      ;;
    --profile=*)
      REQUESTED_PROFILE="${1#--profile=}"
      ;;
    --)
      shift
      ENVY_ARGS+=("$@")
      break
      ;;
    *)
      ENVY_ARGS+=("$1")
      ;;
  esac
  shift
done
set -- "${ENVY_ARGS[@]}"

normalize_dotfiles_profile() {
  case "$1" in
    personal|1) printf '%s\n' personal ;;
    work|2) printf '%s\n' work ;;
    *) return 1 ;;
  esac
}

select_dotfiles_profile() {
  local profile normalized

  if [[ -n "$REQUESTED_PROFILE" ]]; then
    if normalized="$(normalize_dotfiles_profile "$REQUESTED_PROFILE")"; then
      printf '%s\n' "$normalized"
      return
    fi
    echo "ERROR: unknown dotfiles profile '$REQUESTED_PROFILE' (expected work or personal)" >&2
    exit 1
  fi

  if [[ -r "$HOME/.dotfiles_profile" ]]; then
    IFS= read -r profile < "$HOME/.dotfiles_profile" || true
    if [[ -n "$profile" ]]; then
      if normalized="$(normalize_dotfiles_profile "$profile")"; then
        printf '%s\n' "$normalized"
        return
      fi
      echo "ERROR: unknown saved dotfiles profile '$profile' in $HOME/.dotfiles_profile" >&2
      exit 1
    fi
  fi

  if [[ -t 0 && -t 1 ]]; then
    while true; do
      printf 'Select dotfiles profile [personal/work] (default: personal): ' >&2
      IFS= read -r profile
      profile="${profile:-personal}"
      if normalized="$(normalize_dotfiles_profile "$profile")"; then
        printf '%s\n' "$normalized"
        return
      fi
      echo "ERROR: enter personal or work" >&2
    done
  fi

  echo "ERROR: choose a dotfiles profile with --profile work|personal" >&2
  exit 1
}

profile_selection_required() {
  if $CONFIG_ONLY; then
    return 1
  fi
  for arg in "$@"; do
    case "$arg" in
      -h|--help|help|--version|version) return 1 ;;
    esac
  done
  return 0
}

OS="$(uname -s)"
OMARCHY=false
if [[ $OS == Linux ]] && command -v pacman >/dev/null 2>&1; then
  OMARCHY=true
  if [[ $EUID -eq 0 ]]; then
    echo "ERROR: run setup as the Omarchy desktop user, not root" >&2
    exit 1
  fi
  if ! command -v omarchy >/dev/null 2>&1; then
    echo "ERROR: Arch desktop setup requires Omarchy 4.0+ with Lua Hyprland configuration" >&2
    exit 1
  fi
  VERSION="$(omarchy version)"
  if [[ ! $VERSION =~ ^v?([0-9]+)\.[0-9]+ ]] || (( BASH_REMATCH[1] < 4 )); then
    echo "ERROR: Omarchy 4.0+ is required (found $VERSION); back up/detach old links before the supported upgrade" >&2
    exit 1
  fi
  if [[ ! -r ${OMARCHY_PATH:-/usr/share/omarchy}/default/hypr/bootstrap.lua ]]; then
    echo "ERROR: Omarchy's Lua bootstrap is missing; finish the supported upgrade first" >&2
    exit 1
  fi
  if ! command -v hyprctl >/dev/null 2>&1 || ! hyprctl version >/dev/null 2>&1; then
    echo "ERROR: run setup inside the upgraded Hyprland session as its desktop user" >&2
    exit 1
  fi
elif $CONFIG_ONLY; then
  echo "ERROR: --omarchy-config requires an Arch/Omarchy desktop" >&2
  exit 1
fi

if profile_selection_required "$@"; then
  export DOTFILES_PROFILE
  DOTFILES_PROFILE="$(select_dotfiles_profile)"
fi

# Config-only mode must not bootstrap packages or synchronize submodules.
if $CONFIG_ONLY; then
  exec "$SCRIPT_DIR/bin/envy" lua "$SCRIPT_DIR/envy/omarchy_setup.lua"
fi

bootstrap_linux_curl() {
  if command -v curl >/dev/null 2>&1; then
    return
  fi

  if command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update
    sudo apt-get install -y curl ca-certificates
  elif command -v pacman >/dev/null 2>&1; then
    sudo pacman -S --needed --noconfirm curl ca-certificates
  else
    echo "ERROR: curl is required and no supported Linux package manager was found" >&2
    exit 1
  fi
}

case "$OS" in
  Darwin)
    if ! command -v brew >/dev/null 2>&1; then
      echo "Installing Homebrew..." >&2
      NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi

    if [[ -x /opt/homebrew/bin/brew ]]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -x /usr/local/bin/brew ]]; then
      eval "$(/usr/local/bin/brew shellenv)"
    fi
    ;;
  Linux)
    bootstrap_linux_curl
    if ! command -v apt-get >/dev/null 2>&1 && ! command -v pacman >/dev/null 2>&1; then
      echo "ERROR: supported Linux platforms require apt-get or pacman" >&2
      exit 1
    fi
    ;;
  *)
    echo "ERROR: supported platforms are macOS and Linux" >&2
    exit 1
    ;;
esac

for command in curl tar git; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "ERROR: required bootstrap command is missing: $command" >&2
    exit 1
  fi
done

# Explicit Envy arguments retain their original semantics (help, package queries).
if $OMARCHY && [[ $# -eq 0 ]]; then
  "$SCRIPT_DIR/bin/envy" lua "$SCRIPT_DIR/envy/omarchy_setup.lua"
fi

if git -C "$SCRIPT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git -C "$SCRIPT_DIR" submodule sync --recursive
  git -C "$SCRIPT_DIR" submodule update --init --recursive
fi

exec "$SCRIPT_DIR/bin/envy" sync "$@"
