CompileFlags:
  CompilationDatabase: build/firmware
  Add:
    # Target 32-bit ARM architecture (fixes type size mismatches)
    - --target=arm-none-eabi
    - -mcpu=cortex-m33
    - -mthumb
    - -mfpu=fpv5-sp-d16
    - -mfloat-abi=hard
    # Force 32-bit long type for ARM target
    - -D__SIZEOF_LONG__=4
    - -D__SIZEOF_POINTER__=4
    # Suppress some warnings that might be noisy in the editor
    - -Wno-unknown-warning-option
  Remove:
    # Remove path prefix mapping that can confuse clangd
    - -ffile-prefix-map*

Diagnostics:
  # Suppress some common embedded development false positives
  UnusedIncludes: None
  MissingIncludes: None
---
If:
  PathMatch:
    - test/.*
    - .*/tests/.*
    - .*_test\.c
    - tools/asic-simulator/.*
CompileFlags:
  CompilationDatabase: build/host
