_dotfiles_bash_prepend_path() {
  local directory
  for directory in "$@"; do
    [[ -d $directory ]] || continue
    case ":${PATH-}:" in
      *":$directory:"*) ;;
      *) PATH="$directory${PATH:+:$PATH}" ;;
    esac
  done
}

if [[ $OSTYPE == darwin* ]]; then
  if [[ -x /opt/homebrew/bin/brew ]]; then
    _dotfiles_bash_prepend_path /opt/homebrew/sbin /opt/homebrew/bin
  elif [[ -x /usr/local/bin/brew ]]; then
    _dotfiles_bash_prepend_path /usr/local/sbin /usr/local/bin
  fi
fi

_dotfiles_bash_prepend_path "$HOME/.bun/bin" "$HOME/.cargo/bin" "$HOME/bin" "$HOME/.local/bin"
export PATH
unset -f _dotfiles_bash_prepend_path

if [[ -r $HOME/.config/local_config.bash ]]; then
  source "$HOME/.config/local_config.bash"
fi

[[ $- == *i* ]] || return 0

if [[ -z ${EDITOR:-} ]]; then
  if command -v nvim >/dev/null 2>&1; then
    EDITOR=nvim
  else
    EDITOR=vi
  fi
fi
export EDITOR VISUAL="${VISUAL:-$EDITOR}"

alias ..='cd ..'
alias ...='cd ../..'
alias l='ls -l'
alias ll='ls -la'
alias g='git'
