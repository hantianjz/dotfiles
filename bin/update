#!/usr/bin/env bash
set -u

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'
DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
failures=0

section() { echo -e "\n${BLUE}==> $1${NC}"; }
success() { echo -e "${GREEN}    done${NC}"; }
skip() { echo "    skipped (not available)"; }
fail() { echo -e "${RED}    failed${NC}"; }

run() {
  if "$@"; then
    success
  else
    fail
    failures=$((failures + 1))
  fi
}

update_direct_herdr() {
  local herdr_bin
  herdr_bin="$(command -v herdr 2>/dev/null || true)"
  [[ -n "$herdr_bin" ]] || herdr_bin="$HOME/.local/bin/herdr"
  if [[ -x "$herdr_bin" ]]; then
    section "Updating Herdr"
    run "$herdr_bin" update
  fi
}

update_herdr_plugins() {
  local herdr_bin plugin
  herdr_bin="$(command -v herdr 2>/dev/null || true)"
  [[ -n "$herdr_bin" ]] || herdr_bin="$HOME/.local/bin/herdr"
  [[ -x "$herdr_bin" ]] || return

  section "Updating Herdr plugins"
  while IFS= read -r plugin; do
    [[ -n "$plugin" && "$plugin" != \#* ]] || continue
    run "$herdr_bin" plugin install "$plugin" -y
  done <"$DOTFILES_ROOT/config/herdr/plugins"
}

PACKAGE_MANAGER=""
case "$(uname -s)" in
  Darwin)
    if command -v brew >/dev/null 2>&1; then
      PACKAGE_MANAGER=brew
    fi
    ;;
  Linux)
    if command -v pacman >/dev/null 2>&1; then
      PACKAGE_MANAGER=pacman
    elif command -v apt-get >/dev/null 2>&1 && command -v dpkg-query >/dev/null 2>&1; then
      PACKAGE_MANAGER=apt
    fi
    ;;
esac

case "$PACKAGE_MANAGER" in
  brew)
    section "Updating Homebrew packages"
    run brew update
    run brew upgrade
    ;;
  apt)
    section "Updating APT packages"
    run sudo apt-get update
    run sudo apt-get upgrade -y
    update_direct_herdr
    ;;
  pacman)
    if command -v omarchy >/dev/null 2>&1; then
      section "Updating Omarchy and system packages"
      run omarchy update -y
    else
      section "Updating Pacman packages"
      run sudo pacman -Syu --noconfirm
      update_direct_herdr
    fi
    ;;
  *)
    section "System packages"
    skip
    ;;
esac

update_herdr_plugins

if command -v herdr-app >/dev/null 2>&1 || [[ -x "$HOME/.local/bin/herdr-app" ]]; then
  section "Updating Herdr app"
  run bash -o pipefail -c 'curl -fsSL https://releases.herdr.dev/app/install.sh | sh'
fi

export PATH="$PATH:$HOME/.local/bin:$HOME/.bun/bin"
if command -v bun >/dev/null 2>&1; then
  section "Updating Bun"
  run bun upgrade
else
  section "Bun"
  skip
fi

if command -v omp >/dev/null 2>&1; then
  if [[ "$PACKAGE_MANAGER" != brew ]]; then
    section "Updating omp"
    run omp update
  fi
  section "Updating omp plugins"
  # Git-source plugins refresh through install; --plugins only upgrades marketplaces.
  run omp plugin install github:phenome/omp-ponytail-caveman
else
  section "omp"
  skip
fi

rustup_bin="$(command -v rustup 2>/dev/null || true)"
[[ -n "$rustup_bin" ]] || rustup_bin="$HOME/.cargo/bin/rustup"
if [[ -x "$rustup_bin" ]]; then
  section "Updating Rust toolchain"
  run "$rustup_bin" update
else
  section "Rustup"
  skip
fi

section "Updating tmx"
run "$DOTFILES_ROOT/bin/envy" --project "$DOTFILES_ROOT" install local.tmx@r0

if [[ "$PACKAGE_MANAGER" == apt ]]; then
  section "Updating Yazi"
  run "$DOTFILES_ROOT/bin/envy" --project "$DOTFILES_ROOT" install local.yazi@r0

  section "Updating Rust tools"
  if "$DOTFILES_ROOT/bin/envy" --project "$DOTFILES_ROOT" install local.binstall@r0; then
    run bash "$DOTFILES_ROOT/scripts/rust-tools" update
  else
    fail
    failures=$((failures + 1))
  fi
fi

if [[ -L "$HOME/.config/tmux" && "$HOME/.config/tmux" -ef "$DOTFILES_ROOT/tmux" ]]; then
  section "Updating tmux plugins"
  run "$DOTFILES_ROOT/bin/envy" --project "$DOTFILES_ROOT" vendor --all
else
  section "Tmux plugins"
  skip
fi

if command -v fish >/dev/null 2>&1 && fish -c 'type -q fisher' >/dev/null 2>&1; then
  section "Updating Fisher plugins"
  run fish -c 'fisher update'
else
  section "Fisher"
  skip
fi

if (( failures == 0 )); then
  echo -e "\n${GREEN}Update complete.${NC}"
else
  printf '\nUpdate completed with %d failure(s).\n' "$failures"
  exit 1
fi
