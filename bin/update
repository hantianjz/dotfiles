#!/usr/bin/env bash
set -u

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'
DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

section() { echo -e "\n${BLUE}==> $1${NC}"; }
success() { echo -e "${GREEN}    done${NC}"; }
skip() { echo "    skipped (not available)"; }
fail() { echo -e "${RED}    failed${NC}"; }

run() {
  if "$@"; then
    success
  else
    fail
  fi
}

update_direct_herdr() {
  local herdr_bin
  herdr_bin="$(command -v herdr 2>/dev/null || true)"
  [[ -n "$herdr_bin" ]] || herdr_bin="$HOME/.local/bin/herdr"
  if [[ -x "$herdr_bin" ]]; then
    section "Updating Herdr"
    run "$herdr_bin" update
  fi
}

update_herdr_plugins() {
  local herdr_bin plugin
  herdr_bin="$(command -v herdr 2>/dev/null || true)"
  [[ -n "$herdr_bin" ]] || herdr_bin="$HOME/.local/bin/herdr"
  [[ -x "$herdr_bin" ]] || return

  section "Updating Herdr plugins"
  while IFS= read -r plugin; do
    [[ -n "$plugin" && "$plugin" != \#* ]] || continue
    run "$herdr_bin" plugin install "$plugin" -y
  done <"$DOTFILES_ROOT/config/herdr/plugins"
}

if command -v brew >/dev/null 2>&1; then
  section "Updating Homebrew packages"
  run brew update
  run brew upgrade
elif command -v apt-get >/dev/null 2>&1; then
  section "Updating APT packages"
  run sudo apt-get update
  run sudo apt-get upgrade -y
  update_direct_herdr
elif command -v pacman >/dev/null 2>&1; then
  section "Updating Pacman packages"
  run sudo pacman -Syu --noconfirm
  update_direct_herdr
else
  section "System packages"
  skip
fi

update_herdr_plugins

rustup_bin="$(command -v rustup 2>/dev/null || true)"
[[ -n "$rustup_bin" ]] || rustup_bin="$HOME/.cargo/bin/rustup"
if [[ -x "$rustup_bin" ]]; then
  section "Updating Rust toolchain"
  run "$rustup_bin" update
else
  section "Rustup"
  skip
fi

cargo_bin="$(command -v cargo 2>/dev/null || true)"
[[ -n "$cargo_bin" ]] || cargo_bin="$HOME/.cargo/bin/cargo"
if [[ -x "$cargo_bin" ]]; then
  section "Updating Cargo tools"
  run "$cargo_bin" install --locked --git https://github.com/hantianjz/tmx --rev 87b1e7b150b0c2f60f1d210b9dbd6873b7f1cb84

  if command -v apt-get >/dev/null 2>&1; then
    for crate in diskus eza git-delta gping hexyl typos-cli; do
      run "$cargo_bin" install --locked "$crate"
    done
    run "$cargo_bin" install --force --locked yazi-build
  fi
else
  section "Cargo"
  skip
fi

uv_bin="$(command -v uv 2>/dev/null || true)"
[[ -n "$uv_bin" ]] || uv_bin="$HOME/.local/bin/uv"
if [[ -x "$uv_bin" ]]; then
  section "Updating uv tools"
  run "$uv_bin" tool upgrade bpython
  run "$uv_bin" tool upgrade httpie
else
  section "uv"
  skip
fi

if [[ -x "$HOME/.config/tmux/plugins/tpm/bin/update_plugins" ]]; then
  section "Updating tmux plugins"
  run "$HOME/.config/tmux/plugins/tpm/bin/update_plugins" all
else
  section "Tmux plugins"
  skip
fi

if command -v fish >/dev/null 2>&1 && fish -c 'type -q fisher' >/dev/null 2>&1; then
  section "Updating Fisher plugins"
  run fish -c 'fisher update'
else
  section "Fisher"
  skip
fi

echo -e "\n${GREEN}Update complete.${NC}"
